{
    "chat.agent.maxRequests": 50,
    "chat.permissions.default": "Manual permissions",
    "chat.tools.terminal.enableAutoApprove": true,
    "chat.tools.terminal.ignoreDefaultAutoApproveRules": false,
    "chat.tools.terminal.blockDetectedFileWrites": "outsideWorkspace",
    "chat.tools.terminal.autoApprove": {
        "/\\b(chmod|chown|chgrp|setfacl|chattr)\\b/i": {
            "approve": false,
            "matchCommandLine": true
        },
        "/\\b(rm|shred|wipe|dd|mkfs)\\b/i": {
            "approve": false,
            "matchCommandLine": true
        },
        "/\\b(sudo|su|doas|pkexec)\\b/i": {
            "approve": false,
            "matchCommandLine": true
        },
        "/\\b(nix-env -[ei]|nix profile (install|remove)|pacman -[R|S])\\b/i": {
            "approve": false,
            "matchCommandLine": true
        },
        "nix-instantiate": true,
        "printf": true
    },
    "chat.viewSessions.orientation": "stacked",
    "chat.sessionSync.enabled": true,
    "editor.wordWrap": "bounded",
    "editor.minimap.autohide": "scroll",
    "editor.autoIndentOnPaste": true,
    "editor.detectIndentation": false,
    "editor.wordWrapColumn": 120,
    "workbench.iconTheme": "material-icon-theme",
    "vim.useSystemClipboard": true,
    "chat.tools.urls.autoApprove": {
        "https://code.visualstudio.com": true,
        "https://github.com/microsoft/vscode/wiki/*": true,
        "https://wiki.hypr.land": true
    },
    "workbench.startupEditor": "none",
    "workbench.colorTheme": "Dracula Theme"
}